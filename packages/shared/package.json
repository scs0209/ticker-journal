{
  "name": "@ticker-journal/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ."
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "~7.0.2",
    "vitest": "^3.2.4"
  }
}
